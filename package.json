{
  "name": "ai-for-developers-project-386",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "api:generate": "pnpm --filter contract generate && pnpm --filter client generate:sdk",
    "build": "pnpm api:generate && pnpm --filter client build && pnpm --filter server build",
    "start": "pnpm --filter server start",
    "test": "pnpm --filter server test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0"
  }
}
